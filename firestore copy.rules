rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Customer profiles are managed by the trusted backend.
    match /users/{userId} {
      allow read, write: if false;
    }

    // Bookings are written/read through the Node backend using
    // Firebase Admin SDK. Admin SDK bypasses these client rules.
    // Keeping direct browser access disabled prevents customers
    // from reading other customers' bookings.
    match /bookings/{bookingId} {
      allow read, write: if false;
    }
  }
}
